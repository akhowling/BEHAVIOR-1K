(define (problem knock_over_chair-0)
    (:domain omnigibson)

    (:objects
        chair.n.01_1 - chair.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop chair.n.01_1 floor.n.01_1)
        (inroom floor.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (not
            (ontop chair.n.01_1 floor.n.01_1)
        )
    )
)