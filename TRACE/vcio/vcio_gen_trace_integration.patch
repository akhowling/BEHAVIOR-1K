+    """
+    Stateful VCIO LLM agent.
+
+    Keeps the same interface expected by vcio_gen/framework.py:
+        responseText = agent.chatCall(userMessage)
+
+    Backend:
+        local Ollama JSON mode
+    """
+
+    def __init__(self, systemInstruction):
+        self.m_systemInstruction = systemInstruction
+        self.m_history = []
+
+    def chatCall(self, userMessage):
+        try:
+            history_text = ""
+
+            for msg in self.m_history:
+                role = msg.get("role", "unknown")
+                content = msg.get("content", "")
+                history_text += f"{role}: {content}\n\n"
+
+            if history_text:
+                full_user_prompt = (
+                    "Conversation history:\n"
+                    f"{history_text}\n"
+                    "New user message:\n"
+                    f"{userMessage}"
+                )
+            else:
+                full_user_prompt = userMessage
+
+            response_json = _ollama_chat_json(
+                system_prompt=self.m_systemInstruction,
+                user_prompt=full_user_prompt,
+                temperature=0.0,
+            )
+
+            response_text = json.dumps(response_json)
+
+            self.m_history.append({
+                "role": "user",
+                "content": userMessage,
+            })
+
+            self.m_history.append({
+                "role": "assistant",
+                "content": response_text,
+            })
+
+            return response_text
+
+        except Exception as errorInstance:
+            print(f"Error during stateful chat call: {errorInstance}")
+            return None
